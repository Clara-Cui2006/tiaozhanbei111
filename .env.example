# Copy this file to .env before running docker compose.
# Do not commit or share the real .env if it contains an API key.

HOST_PORT=8080
APP_ENV=production
DATABASE_PATH=/data/platform.db
TOKEN_TTL_MINUTES=30

# Required in production: use at least 32 random characters.
JWT_SECRET=please-change-this-to-a-random-string-at-least-32-chars

# Created only when the user table is empty.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_123456

# Optional OpenAI-compatible intranet model gateway.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=60
