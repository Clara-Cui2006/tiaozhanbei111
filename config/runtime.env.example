APP_ENV=production
DATABASE_PATH=/var/lib/community-legal-risk-platform/platform.db
JWT_SECRET=请替换为至少32位的随机字符串
TOKEN_TTL_MINUTES=30
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=请替换为首次登录使用的强密码

# 院内统一模型采用 OpenAI 兼容协议时填写；未配置时 AI 功能明确返回“尚未配置”。
MODEL_BASE_URL=http://院内模型服务IP:端口/v1
MODEL_API_KEY=
MODEL_NAME=院内统一模型名称
MODEL_TIMEOUT_SECONDS=60
