# Copy this file to:
# /etc/community-legal-risk-platform/runtime.env
#
# Never commit the real runtime.env file. It may contain passwords,
# model gateway addresses, API keys, and database paths.

APP_ENV=production
DATABASE_PATH=/var/lib/community-legal-risk-platform/platform.db

# Required in production. Use at least 32 random characters.
JWT_SECRET=replace-with-at-least-32-random-characters
TOKEN_TTL_MINUTES=30

# The first admin account is created only when the user table is empty.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-password

# Optional intranet model gateway.
# Leave these empty for tomorrow if no approved model gateway is available.
# The AI endpoint will return an explicit "model not configured" result.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=60
