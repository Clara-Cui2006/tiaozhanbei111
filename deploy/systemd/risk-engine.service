[Unit]
Description=Community Legal Risk Native Engine
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=__NATIVE_BUILD_DIR__

PermissionsStartOnly=true
ExecStartPre=__SCRIPTS_DIR__/load_crypto_accel_module.sh
ExecStartPre=/bin/mkdir -p /run/__APP_NAME__
ExecStartPre=/usr/bin/openssl enc -d -aes-256-cbc -pbkdf2 -in __SECRETS_DIR__/runtime.env.enc -out /run/__APP_NAME__/runtime.env -pass file:__SECRETS_DIR__/runtime.key
ExecStartPre=/bin/chmod 600 /run/__APP_NAME__/runtime.env

EnvironmentFile=/run/__APP_NAME__/runtime.env
ExecStart=__NATIVE_BUILD_DIR__/risk_engine_demo
ExecStopPost=/bin/rm -f /run/__APP_NAME__/runtime.env

Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target