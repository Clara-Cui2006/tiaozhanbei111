.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a1225, #0d1e38);
  padding: 0 24rpx 40rpx;
}

.hero {
  padding: 60rpx 20rpx 40rpx;
  text-align: center;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #d8f0ff;
  line-height: 1.3;
}

.hero-title.accent {
  color: #5ad6ff;
  margin-bottom: 16rpx;
}

.hero-subtitle {
  font-size: 22rpx;
  color: #6a9ab8;
  letter-spacing: 4rpx;
  margin-top: 12rpx;
}

.section-title {
  font-size: 28rpx;
  color: #9fd4f2;
  margin: 20rpx 0 16rpx;
  font-weight: 600;
  text-align: center;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
}

.grid-item {
  width: 180rpx;
  background: rgba(14, 39, 78, 0.7);
  border: 1rpx solid rgba(90, 214, 255, 0.15);
  border-radius: 16rpx;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  transition: all 0.2s;
}

.grid-item:active {
  background: rgba(30, 80, 140, 0.6);
  border-color: rgba(90, 214, 255, 0.4);
}

.grid-icon {
  font-size: 48rpx;
}

.grid-label {
  font-size: 22rpx;
  color: #c8e8ff;
  font-weight: 500;
}

.enter-btn {
  margin: 32rpx auto 0;
  width: 80%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(180deg, #3ba0ff, #1a6dd4);
  border-radius: 44rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 120, 255, 0.35);
}

.enter-btn:active {
  opacity: 0.85;
}

.footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: 20rpx;
  color: #4a7090;
}
